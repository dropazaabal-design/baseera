# Credentials for `studio analytics fetch` (lib/algorithm-intelligence/ingestion/providers.js).
# Copy to .env (never committed) or export in your shell. They are read
# server-side only: never put them in the browser editor, a design file or
# an export. Every engine feature works without them; history can always be
# imported from a JSON or CSV file instead (studio analytics import ...).

# Instagram Graph API (Instagram API with Facebook Login): a long-lived
# token with instagram_basic and instagram_manage_insights, and the IG user id.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Optional: https://graph.instagram.com for Instagram API with Instagram Login
INSTAGRAM_GRAPH_BASE=

# Facebook Pages API: a Page access token with read_insights, and the Page id.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Graph API version for both (default v25.0).
META_GRAPH_VERSION=

# X API v2: your user id, and either an OAuth 2.0 user-context token (adds
# non-public and organic metrics for your own posts from the last 30 days)
# or an app bearer token (public metrics only).
X_USER_ID=
X_USER_ACCESS_TOKEN=
X_BEARER_TOKEN=
