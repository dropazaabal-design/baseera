{
  "templates": [
    {
      "id": "cover",
      "label": "غلاف",
      "description": "عنوان جذّاب يفتتح الكاروسيل",
      "hideBrandBadge": false,
      "fields": [
        {
          "key": "kicker",
          "label": "الشارة",
          "type": "text"
        },
        {
          "key": "title",
          "label": "العنوان الرئيسي",
          "type": "textarea"
        },
        {
          "key": "subtitle",
          "label": "العنوان الفرعي",
          "type": "textarea"
        }
      ]
    },
    {
      "id": "listicle",
      "label": "قائمة خطوات",
      "description": "خطوات أو نقاط مرقّمة",
      "hideBrandBadge": false,
      "fields": [
        {
          "key": "title",
          "label": "العنوان",
          "type": "textarea"
        },
        {
          "key": "items",
          "label": "العناصر",
          "type": "list"
        },
        {
          "key": "start",
          "label": "يبدأ الترقيم من",
          "type": "number",
          "hint": "لمتابعة الترقيم عبر أكثر من شريحة"
        }
      ]
    },
    {
      "id": "quote",
      "label": "اقتباس",
      "description": "اقتباس مؤثر مع اسم قائله",
      "hideBrandBadge": false,
      "fields": [
        {
          "key": "quote",
          "label": "نص الاقتباس",
          "type": "textarea"
        },
        {
          "key": "author",
          "label": "القائل",
          "type": "text"
        },
        {
          "key": "role",
          "label": "الصفة",
          "type": "text"
        }
      ]
    },
    {
      "id": "comparison",
      "label": "قبل / بعد",
      "description": "مقارنة بين حالتين في عمودين",
      "hideBrandBadge": false,
      "fields": [
        {
          "key": "title",
          "label": "العنوان",
          "type": "textarea"
        },
        {
          "key": "beforeLabel",
          "label": "عنوان العمود الأول",
          "type": "text"
        },
        {
          "key": "before",
          "label": "عناصر العمود الأول",
          "type": "list"
        },
        {
          "key": "afterLabel",
          "label": "عنوان العمود الثاني",
          "type": "text"
        },
        {
          "key": "after",
          "label": "عناصر العمود الثاني",
          "type": "list"
        }
      ]
    },
    {
      "id": "outro",
      "label": "خاتمة",
      "description": "دعوة للحفظ والمتابعة وحساباتك",
      "hideBrandBadge": true,
      "fields": [
        {
          "key": "title",
          "label": "العنوان",
          "type": "textarea"
        },
        {
          "key": "subtitle",
          "label": "العنوان الفرعي",
          "type": "textarea"
        },
        {
          "key": "save",
          "label": "زر الحفظ",
          "type": "text"
        },
        {
          "key": "share",
          "label": "زر المشاركة",
          "type": "text"
        },
        {
          "key": "follow",
          "label": "زر المتابعة",
          "type": "text"
        },
        {
          "key": "socials",
          "label": "الحسابات والروابط",
          "type": "list"
        }
      ]
    }
