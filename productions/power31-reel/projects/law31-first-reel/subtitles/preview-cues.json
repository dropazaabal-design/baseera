{
  "status": "ESTIMATED_NO_AUDIO",
  "cues": [
    {
      "start": 0.05,
      "end": 2.923636363636364,
      "text": "تخيّل واحدًا يقول لك: «اختر الباب",
      "sceneId": "scene-01"
    },
    {
      "start": 3.0136363636363637,
      "end": 5.3933333333333335,
      "text": "اللي يعجبك». تفكّر، وتقارن، وتختار.",
      "sceneId": "scene-01"
    },
    {
      "start": 5.683333333333334,
      "end": 8.679047619047621,
      "text": "لكن المفاجأة؟ البابان\nيؤدّيان إلى المكان",
      "sceneId": "scene-02"
    },
    {
      "start": 8.76904761904762,
      "end": 9.193333333333335,
      "text": "نفسه!",
      "sceneId": "scene-02"
    },
    {
      "start": 9.483333333333334,
      "end": 12.47904761904762,
      "text": "لأن شخصًا آخر رسم الطريقين، وحدّد",
      "sceneId": "scene-03"
    },
    {
      "start": 12.56904761904762,
      "end": 12.993333333333334,
      "text": "نهايتهما.",
      "sceneId": "scene-03"
    },
    {
      "start": 13.283333333333333,
      "end": 16.043333333333333,
      "text": "هذه فكرة القانون الحادي والثلاثين في",
      "sceneId": "scene-04"
    },
    {
      "start": 16.133333333333333,
      "end": 18.893333333333334,
      "text": "«ثمانية وأربعون قانونًا\nللسلطة» لروبرت غرين:",
      "sceneId": "scene-04"
    },
    {
      "start": 18.983333333333334,
      "end": 21.743333333333336,
      "text": "أحيانًا تكون السيطرة\nبالتحكّم في خياراتك.",
      "sceneId": "scene-04"
    },
    {
      "start": 21.833333333333336,
      "end": 24.593333333333337,
      "text": "نفهمها لنحمي قرارنا، لا لنحاصر الناس.",
      "sceneId": "scene-04"
    },
    {
      "start": 24.883333333333333,
      "end": 27.676666666666666,
      "text": "في العمل: «إمّا تقبل ضغطًا إضافيًا",
      "sceneId": "scene-05"
    },
    {
      "start": 27.766666666666666,
      "end": 30.56,
      "text": "بلا نقاش، أو أنت غير ملتزم».",
      "sceneId": "scene-05"
    },
    {
      "start": 30.65,
      "end": 33.443333333333335,
      "text": "وفجأة، تحس أن أمامك طريقين فقط!",
      "sceneId": "scene-05"
    },
    {
      "start": 33.73333333333333,
      "end": 36.60696969696969,
      "text": "لكن أين التفاوض؟\nوتوزيع المهام؟ والاتفاق",
      "sceneId": "scene-06"
    },
    {
      "start": 36.69696969696969,
      "end": 39.07666666666666,
      "text": "الواضح الذي يحفظ حق الجميع؟",
      "sceneId": "scene-06"
    },
    {
      "start": 39.36666666666667,
      "end": 42.17666666666667,
      "text": "وفي العلاقات: «إمّا توافقني في كل",
      "sceneId": "scene-07"
    },
    {
      "start": 42.266666666666666,
      "end": 45.07666666666667,
      "text": "شيء، أو أنت ما تهتم بي».",
      "sceneId": "scene-07"
    },
    {
      "start": 45.166666666666664,
      "end": 47.01,
      "text": "وكأن الاهتمام اختبار طاعة!",
      "sceneId": "scene-07"
    },
    {
      "start": 47.3,
      "end": 50.14076923076923,
      "text": "لكن الاحترام ما يعني تلغي رأيك.",
      "sceneId": "scene-08"
    },
    {
      "start": 50.230769230769226,
      "end": 53.07153846153846,
      "text": "من حقك تختلف، وتناقش، وتحافظ على",
      "sceneId": "scene-08"
    },
    {
      "start": 53.161538461538456,
      "end": 53.559999999999995,
      "text": "حدودك.",
      "sceneId": "scene-08"
    },
    {
      "start": 53.849999999999994,
      "end": 56.75,
      "text": "وفي العائلة: «إمّا تختار التخصص اللي",
      "sceneId": "scene-09"
    },
    {
      "start": 56.839999999999996,
      "end": 58.74333333333333,
      "text": "نريده، أو تخيّب أملنا».",
      "sceneId": "scene-09"
    },
    {
      "start": 59.03333333333333,
      "end": 61.843333333333334,
      "text": "قد يكون وراء الكلام خوف حقيقي",
      "sceneId": "scene-10"
    },
    {
      "start": 61.93333333333333,
      "end": 64.74333333333333,
      "text": "على مستقبلك. لكن هذا لا يمنع",
      "sceneId": "scene-10"
    },
    {
      "start": 64.83333333333333,
      "end": 66.67666666666666,
      "text": "الحوار، ولا يلغي البدائل.",
      "sceneId": "scene-10"
    },
    {
      "start": 66.96666666666667,
      "end": 69.73857142857143,
      "text": "وانتبه: مو كل موقف فيه خياران",
      "sceneId": "scene-11"
    },
    {
      "start": 69.82857142857144,
      "end": 72.6004761904762,
      "text": "يعني تلاعبًا. لكن إذا حسّيت أنك",
      "sceneId": "scene-11"
    },
    {
      "start": 72.6904761904762,
      "end": 75.46238095238097,
      "text": "محاصر، اسأل: من حدّد الخيارات؟ وهل",
      "sceneId": "scene-11"
    },
    {
      "start": 75.55238095238097,
      "end": 76.89333333333335,
      "text": "فيه خيار ثالث؟",
      "sceneId": "scene-11"
    },
    {
      "start": 77.18333333333334,
      "end": 79.98222222222222,
      "text": "ليس كل من يمنحك خيارًا، يمنحك",
      "sceneId": "scene-12"
    },
    {
      "start": 80.07222222222222,
      "end": 82.8711111111111,
      "text": "حرية. وأحيانًا أقوى قرار... أن ترفض",
      "sceneId": "scene-12"
    },
    {
      "start": 82.96111111111111,
      "end": 85.75999999999999,
      "text": "الاختيار بين بابين لا يناسبانك أصلًا.",
      "sceneId": "scene-12"
    }
  ]
}