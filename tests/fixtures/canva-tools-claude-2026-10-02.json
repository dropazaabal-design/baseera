  {
   "name": "mcp__Canva__read-design",
   "description": "Read a Canva design: its text and wording, page count, title and metadata, page preview thumbnails, and presenter notes. Can also open or continue an editing transaction.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "design_id": {
      "type": "string"
     },
     "filter": {
      "type": "object",
      "properties": {
       "element_ids": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "fields": {
        "type": "array",
        "items": {
         "type": "string",
         "enum": [
          "design_metadata",
          "page_metadata",
          "design_content",
          "thumbnails",
          "presenter_notes"
         ]
        }
       },
       "page_indices": {
        "type": "array",
        "items": {
         "type": "integer"
        }
       },
       "thumbnail_pages": {
        "type": "array",
        "items": {
         "type": "integer"
        }
       }
      }
     },
     "open_transaction": {
      "type": "boolean"
     },
     "transaction_id": {
      "type": "string"
     },
     "user_intent": {
      "type": "string",
      "description": "Mandatory description of what the user is trying to accomplish."
     }
    },
    "required": [
     "design_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "mcp__Canva__import-design-from-url",
   "description": "Convert content at a public URL into a new Canva design.\n\nUse to turn a publicly hosted PDF, slide deck (PowerPoint or Keynote), document (Word, Pages, or Markdown), spreadsheet (Excel, CSV, or Numbers), webpage or HTML, or design file (Photoshop or Illustrator) into a Canva design.\n\nOnly call with a public HTTPS URL. Do not use for local, private, or agent-generated files, or to break a flat PNG, JPEG, or WEBP into separately editable layers.\n\nEach call creates one design and returns its design_id.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "intended_design_type": {
      "type": "string",
      "enum": [
       "instagram_post",
       "instagram_reel",
       "presentation",
       "other"
      ]
     },
     "name": {
      "type": "string",
      "description": "Name for the new Canva design."
     },
     "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https:\\/\\/(?!.*canva\\.com\\/design\\/)(?!.*files\\.oaiusercontent\\.com)(?!.*cdn\\.openai\\.com).*",
      "description": "Public HTTPS URL for the source to convert. Does not accept Canva design URLs, OpenAI file URLs, local paths, private files, or agent-generated files."
     },
     "user_intent": {
      "type": "string",
      "description": "Mandatory description of what the user is trying to accomplish."
     }
    },
    "required": [
     "url",
     "name"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "mcp__Canva__upload-asset-from-url",
   "description": "Import media from an existing public URL into Canva. Do not use for local, private, or agent-generated files.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "format": "uri"
     },
     "user_intent": {
      "type": "string",
      "description": "Mandatory description of what the user is trying to accomplish."
     }
    },
    "required": [
     "url",
     "name"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "mcp__Canva__create-upload-url",
   "description": "Uploads a file (image, video, audio, PDF, or other document) into Canva. Step 1: call this tool to get a single-use upload_url. Step 2: send the raw file bytes as the body of one HTTP POST to that URL.",
